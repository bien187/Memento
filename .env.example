NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never prefix with NEXT_PUBLIC_. Used for token-authorized public reads/account deletion.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: link back to your portfolio from the public demo (/demo). Leave empty to hide it.
NEXT_PUBLIC_PORTFOLIO_URL=
# Enable only after the provider is configured in Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
NEXT_PUBLIC_APPLE_AUTH_ENABLED=false
# Seed only: choose an address and a unique strong password, not production credentials.
SEED_EMAIL=
SEED_PASSWORD=
